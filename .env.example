# Copy to .env and adjust. All values are optional.

# Where crawled data is written
LI_DATA_DIR=data

# Browser: persistent profile dir that keeps your LinkedIn session
LI_BROWSER_PROFILE_DIR=.browser-profile
# "chrome" = installed Google Chrome, empty = Playwright's bundled Chromium
LI_BROWSER_CHANNEL=chrome
LI_HEADLESS=false
# Attach to a Chrome started with --remote-debugging-port=9222 instead
# LI_CDP_URL=http://localhost:9222

# Politeness / rate limiting
LI_MIN_DELAY_S=4
LI_MAX_DELAY_S=9
LI_MAX_REQUESTS_PER_HOUR=120
LI_MAX_ACTIVITIES=20

# Queue: memory | redis
LI_QUEUE_BACKEND=memory
LI_REDIS_URL=redis://localhost:6379/0
